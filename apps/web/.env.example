# Copier en .env.local. Les valeurs de développement sont affichées par `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement. Ne doit JAMAIS être importée depuis un composant "use client" :
# elle contourne la RLS et donnerait à n'importe quel visiteur les pleins pouvoirs sur la base.
SUPABASE_SERVICE_ROLE_KEY=
